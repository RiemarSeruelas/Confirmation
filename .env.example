PGHOST=host.docker.internal
PGPORT=your_database_port
PGDATABASE=your_database_name
PGUSER=your_database_user
PGPASSWORD=replace_with_your_password
PGSSL=false

TZ=Asia/Manila
PORT=5178
NODE_ENV=production

AI_IMAGE_BASE_URL=http://your_image_ai_server
AI_IMAGE_FALLBACK_URL=http://your_image_ai_server
AI_IMAGE_MODEL=qwen3-vl:8b
AI_IMAGE_TIMEOUT_MS=180000

DOCLING_ENABLED=true
DOCLING_BASE_URL=http://host.docker.internal:5006
DOCLING_PATH=/extract
DOCLING_TIMEOUT_MS=120000

# The admin signs in through the same PIN field as everyone else.
ADMIN_PIN=replace_with_your_6_digit_admin_pin

# Keep this stable after PIN accounts are registered. Use at least 32 random characters.
PIN_PEPPER=replace_with_a_long_random_secret_of_at_least_32_characters
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15
